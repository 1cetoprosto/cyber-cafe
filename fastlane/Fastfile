default_platform(:ios)

# Load .env file manually to ensure environment variables are set
require 'dotenv'
dotenv_paths = [
  File.join(__dir__, '.env.ios'),
  File.join(__dir__, '.env.secret'),
  File.expand_path(File.join(__dir__, '..', '.env'))
].select { |path| File.exist?(path) }

Dotenv.load(*dotenv_paths) unless dotenv_paths.empty?

platform :ios do

  # ---------------------------------------------------------------------------
  # Shared Logic
  # ---------------------------------------------------------------------------

  def build_and_distribute(scheme:, bundle_id:)
    # 1. Ensure git status is clean before building
    ensure_git_status_clean

    # 2. Increment build number for the PROJECT
    # Versioning is now centralized in Xcode Project-level build settings:
    #   - MARKETING_VERSION (human-readable version, e.g. 1.1.1)
    #   - CURRENT_PROJECT_VERSION (build number, integer, auto-incremented here)
    # All 3 app targets (Prod/Beta/Dev) + Tests target INHERIT these values
    # from the project, so there is a SINGLE source of truth.
    #
    # Info.plist files for Prod/Beta/Dev now contain:
    #   CFBundleShortVersionString = $(MARKETING_VERSION)
    #   CFBundleVersion            = $(CURRENT_PROJECT_VERSION)
    # so we only bump the project-level CURRENT_PROJECT_VERSION once.
    #
    # Uses Apple's built-in `agvtool` (via fastlane's action) which modifies
    # the .pbxproj project-level build settings correctly (no manual plist edits).
    increment_build_number(
      xcodeproj: "TrackMyCafe.xcodeproj"
    )

    # 3. Commit the version bump (so the repo is clean for next run if build fails)
    commit_version_bump(
      message: "chore: Bump build number [skip ci]",
      force: true
    )

    # 4. Build the app
    build_app(
      workspace: "TrackMyCafe.xcworkspace",
      scheme: scheme,
      clean: true,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    # 4. Upload to TestFlight and add to "External Testers" group
    distribute_external = ENV.fetch("FASTLANE_DISTRIBUTE_EXTERNAL", "false").to_s.downcase == "true"

    upload_options = {
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: false,
      distribute_external: distribute_external,
      changelog: "Updated build"
    }

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    if distribute_external
      upload_options[:groups] = ["External Testers"]
    end

    upload_to_testflight(
      api_key: api_key,
      **upload_options
    )
  end

  # ---------------------------------------------------------------------------
  # Public Lanes
  # ---------------------------------------------------------------------------

  desc "Deploy PROD to TestFlight (Scheme: TrackMyCafe Prod)"
  lane :prod do
    build_and_distribute(
      scheme: "TrackMyCafe Prod",
      bundle_id: "ICSOFT.TrackMyCafe"
    )
  end

  desc "Deploy BETA to TestFlight (Scheme: TrackMyCafe Beta)"
  lane :beta do
    build_and_distribute(
      scheme: "TrackMyCafe Beta",
      bundle_id: "ICSOFT.TrackMyCafe.beta"
    )
  end

  desc "Deploy DEV to TestFlight (Scheme: TrackMyCafe Dev)"
  lane :dev do
    # Note: Ensure "ICSOFT.TrackMyCafe.dev" exists in App Store Connect
    build_and_distribute(
      scheme: "TrackMyCafe Dev",
      bundle_id: "ICSOFT.TrackMyCafe.dev"
    )
  end

end
